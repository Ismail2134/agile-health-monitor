# agile-health-monitor — environment configuratie
# Kopieer naar .env op de VPS en vul waarden in. .env is gitignored en bevat NOOIT echte secrets in git.

# --- PocketBase admin (gebruikt door setup-pb.mjs + app login) ---
PB_ADMIN_EMAIL=admin@healthmonitor.nl
PB_ADMIN_PASSWORD=vervang_dit_met_een_sterk_wachtwoord

# --- App / frontend (publiek via Traefik) ---
# In productie is PB intern op http://pocketbase:8090, dus geen poort in URL.
VITE_POCKETBASE_PUBLIC_URL=https://health.agiledevops.nl
ORIGIN=https://health.agiledevops.nl

# --- Traefik (gebruikt in compose.production.yml) ---
DOMAIN=health.agiledevops.nl
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
